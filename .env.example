# ---------------------------------------------------------------------------
# Variables de entorno del sistema de estacionamientos (version de produccion).
# ---------------------------------------------------------------------------
#
# Este archivo lo usa `docker compose --env-file .env`. El `.env` REAL nunca
# se versiona: ver `.gitignore`.
#
# NINGUN valor de este archivo es un secreto real.
#
# Las variables marcadas como obligatorias no tienen valor por omision
# inventado. Si faltan, el compose NO levanta: es preferible a que arranque
# con una clave de ejemplo.

# --- Aplicacion -------------------------------------------------------------
APP_NAME="Parqueadero"
APP_ENV=production
# Generar con: openssl rand -base64 32
APP_KEY=
APP_DEBUG=false
APP_URL=https://parqueadero.hefestostudio.cl
APP_WEB_URL=https://parqueadero.hefestostudio.cl

# --- Base de datos ----------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=parqueadero

# Rol con el que se conecta la APLICACION.
#
# IMPORTANTE: este rol NO debe ser superusuario ni tener BYPASSRLS. Con
# cualquiera de las dos cosas se salta el aislamiento entre operadores. La
# comprobacion la hace `parqueadero:verificar-aislamiento` en cada arranque.
DB_USERNAME=parqueadero_app
DB_PASSWORD=

# Rol con el que se MIGRA. Puede ser el dueno de la base.
DB_MIGRATE_USERNAME=parqueadero_migra
DB_MIGRATE_PASSWORD=

# --- Identidad --------------------------------------------------------------
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://parqueadero.hefestostudio.cl/api/v1/acceso/callback
AUTHENTIK_GRUPO_ADMIN=parqueadero-administradores
AUTHENTIK_GRUPO_OPERADORES=parqueadero-operadores

# --- TLS --------------------------------------------------------------------
# Correo para los avisos de caducidad del certificado. Sin esto, Caddy avisa
# por consola y nadie lo ve hasta que el certificado vence.
ACME_CORREO=

# --- Parametros del parqueadero ---------------------------------------------
PARQUEADERO_ZONA_HORARIA=America/Santiago
PARQUEADERO_DIAS_AVISO_VENCIMIENTO=15
# Ver la nota de `api/.env.example`: hoy el cobro no lee los minutos de
# cortesia ni el redondeo del operador.
PARQUEADERO_MINUTOS_CORTESIA=10
PARQUEADERO_MINUTOS_REDONDEO=1
PARQUEADERO_FOTO_OBLIGATORIA=false

# --- Respaldos --------------------------------------------------------------
# Donde se dejan los respaldos, EN EL HOST y no en un volumen de Docker: un
# respaldo dentro del mismo servidor que respalda no es un respaldo.
# Ver deploy/respaldos/respaldo.sh y docs/08-RESPALDOS.md.
DIRECCION_RESGARDOS=/var/backups/parqueadero
RETENCION_DIAS=30