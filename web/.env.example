# ---------------------------------------------------------------------------
# Variables de entorno de la interfaz (Nuxt)
# ---------------------------------------------------------------------------
#
# NINGUN valor de este archivo es un secreto real.
#
# `NUXT_API_BASE` es config PRIVADA: solo la usa el servidor de Nuxt para
# reenviar las llamadas a la API de Laravel. El navegador nunca la ve, y por
# eso nunca se expone como `NUXT_PUBLIC_*`.

NUXT_API_BASE=http://localhost:8000
NUXT_PUBLIC_BASE=http://localhost:3000