{
    "name": "hefesto/parqueadero",
    "type": "project",
    "description": "API de Gestion de Estacionamientos de Hefesto Studio. Aplicacion propia: NO es un kit de despliegue de una herramienta de terceros.",
    "keywords": ["hefesto", "parqueadero", "estacionamiento", "tarifas", "boletas", "multitenant", "laravel"],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo_pgsql": "*",
        "laravel/framework": "^13.37",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^2.10",
        "firebase/php-jwt": "^7.2",
        "predis/predis": "^3.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:aislamiento": [
            "@php artisan test --testsuite=Aislamiento"
        ],
        "test:tarifas": [
            "@php artisan test --testsuite=Tarifas"
        ],
        "test:ocupacion": [
            "@php artisan test --testsuite=Ocupacion"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}