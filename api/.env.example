# ---------------------------------------------------------------------------
# API de Gestion de Estacionamientos (Laravel)
# ---------------------------------------------------------------------------
#
# NINGUN valor de este archivo es un secreto real.
#
# La plantilla se copia a `.env` y ahi se completan los valores. El `.env`
# real nunca se versiona: ver `.gitignore`.
#
# Las variables que no tienen valor por omision NO tienen un valor por omision
# inventado en el codigo. Si faltan, el sistema avisa en vez de arrancar con
# algo que parece funcionar.

# --- Aplicacion -----------------------------------------------------------
APP_NAME="Parqueadero"
# `local` muestra los errores en pantalla. En produccion SIEMPRE `production`.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# A donde vuelve el operador despues de entrar. Lo sirve Nuxt.
APP_WEB_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de datos --------------------------------------------------------
# PostgreSQL es obligatorio: el aislamiento entre operadores y la
# inmutabilidad del registro se aplican con RLS y con gatillos, que
# SQLite no tiene. Ver docs/01-ARQUITECTURA.md.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=parqueadero
DB_USERNAME=
# Contrasenia de la base de la aplicacion.
#
# IMPORTANTE: este rol NO debe ser superusuario ni tener `BYPASSRLS`. Con
# cualquiera de las dos cosas se salta el aislamiento. La comprobacion la
# hace `parqueadero:verificar-aislamiento` en cada arranque.
DB_PASSWORD=
# Rol con el que se migra la base. Puede ser el dueno. La aplicacion
# conecta con DB_USERNAME, no con este.
#
# OJO: este es el rol de ARRANQUE. La imagen oficial de PostgreSQL lo crea
# superusuario (`initdb --username="$POSTGRES_USER"`), y con superusuario el
# `FORCE ROW LEVEL SECURITY` no lo sujeta a el. Por eso la aplicacion usa un
# rol aparte, y ese lo crea `deploy/postgres/inicializar-rol.sh` con
# NOSUPERUSER y NOBYPASSRLS explicitos. Ver docs/03.
DB_MIGRATE_USERNAME=
DB_MIGRATE_PASSWORD=

# --- Redis ----------------------------------------------------------------
# Cache de ocupacion, colas y sesion.
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Sesion ---------------------------------------------------------------
# `database` permite revocar una sesion desde la base si alguien pierde el
# equipo de la caseta.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_COOKIE=parqueadero_sesion
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Identidad (Authentik) -------------------------------------------------
# El parqueadero NO guarda contrasenas. Authentik resuelve la identidad y la
# API decide el rol leyendo `usuarios.rol`.
#
# El emisor debe terminar en barra: Authentik lo publica asi, y una barra de
# menos hace que todos los tokens parezcan de otro emisor.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/acceso/callback
AUTHENTIK_SCOPES="openid profile email"
# Algoritmo de firma. RS256 es el que usa Authentik por omision.
AUTHENTIK_ALGORITMO=RS256
# Grupos. NO dan permisos por si solos: el rol vive en la base.
AUTHENTIK_GRUPO_ADMIN=parqueadero-administradores
AUTHENTIK_GRUPO_OPERADORES=parqueadero-operadores

# --- Colas y planificador -------------------------------------------------
# `database` evita depender de Redis para la cola. Con `redis` las tareas
# diferidas se pierden si Redis no levanta.
QUEUE_CONNECTION=database
# El planificador corre dentro del contenedor de la API. Para tareas diarias
# conviene dispararlas desde el sistema. Ver docs/04-INSTALACION.md.
# 0 = nunca correr automaticamente. El comando se lanza a mano.
SCHEDULE_RUNNER=false

# --- Cache ----------------------------------------------------------------
CACHE_STORE=redis

# --- Correo ---------------------------------------------------------------
# No se usa: el sistema deja avisos en bitacora, no manda correos. Ver
# docs/06-INGRESO-VEHICULO.md.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=parqueadero@ejemplo.cl

# --- Parametros del parqueadero -------------------------------------------
# Todos tienen valor por omision en `config/parqueadero.php`. Se declaran
# aca para que se puedan cambiar sin tocar el codigo.
#
# OJO: `minutos_cortesia` y `minutos_redondeo` NO participan del cobro de
# hoy. El calculo usa `tarifas.minutos_incluidos` y
# `tarifas.minutos_por_fraccion`, que son por tarifa. Ver
# docs/10-PRUEBAS-Y-ESTADO.md, apartado de pendientes.
PARQUEADERO_MINUTOS_CORTESIA=10
PARQUEADERO_MINUTOS_REDONDEO=1
PARQUEADERO_DIAS_AVISO_VENCIMIENTO=15
PARQUEADERO_OCUPACION_TTL=30
PARQUEADERO_ZONA_HORARIA=America/Santiago
PARQUEADERO_NORMALIZAR_PATENTE=true
PARQUEADERO_FORMA_PAGO=efectivo
PARQUEADERO_DESCUENTO_MAXIMO=5000
PARQUEADERO_HISTORIAL_POR_PAGINA=100
PARQUEADERO_HISTORIAL_MAXIMO=200

# --- Fotos ----------------------------------------------------------------
# OJO: la foto se guarda como RUTA en la base y la sube la interfaz. Poner
# esto en `true` sin tener montado el volumen deja filas con una ruta que no
# lleva a ninguna parte. Ver docs/10-PRUEBAS-Y-ESTADO.md.
PARQUEADERO_FOTO_OBLIGATORIA=false
PARQUEADERO_FOTO_RUTA_BASE=fotos

# --- Aislamiento ----------------------------------------------------------
# Cuando esta en `true`, el entrypoint corre `parqueadero:verificar-aislamiento`
# antes de levantar php-fpm. Si la RLS no esta puesta, es preferible que la
# API no levante a que quede despidiendo datos de otros operadores.
PARQUEADERO_VERIFICAR_AISLAMIENTO=true

# --- Pruebas --------------------------------------------------------------
# La conexion de pruebas esta FIJA en `phpunit.xml` y NO se lee de aqui.
# Ver la nota de ese archivo: correr el aislamiento en SQLite daria verde
# sin comprobar nada.